{
  "manifest_version": 3,
  "name": "MediaSniff Inspector",
  "version": "0.1.0",
  "description": "Inspect accessible media resources safely.",
  "permissions": ["activeTab", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
